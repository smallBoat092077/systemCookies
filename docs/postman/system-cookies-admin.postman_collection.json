  "item": [
    {
      "name": "订单管理",
      "item": [
        {
          "name": "订单分页查询",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/orders?pageNum=1&pageSize=10&userId=&status=&keyword=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "orders"],
              "query": [
                { "key": "pageNum", "value": "1", "description": "当前页，默认 1" },
                { "key": "pageSize", "value": "10", "description": "每页条数，默认 10" },
                { "key": "userId", "value": "", "description": "用户 ID；不传 = 查全部" },
                { "key": "status", "value": "", "description": "0待支付 1待制作 2制作中 3已完成 4已取消" },
                { "key": "keyword", "value": "", "description": "订单号关键字（模糊匹配）" }
              ]
            },
            "description": "订单分页（不传 userId 表示查全部用户）"
          },
          "response": [
            {
              "name": "成功示例",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"code\": 200,\n  \"message\": \"操作成功\",\n  \"data\": {\n    \"records\": [\n      {\n        \"id\": 1024,\n        \"orderNo\": \"SC202603120001\",\n        \"userId\": 8,\n        \"totalAmount\": 88.00,\n        \"payAmount\": 88.00,\n        \"itemCount\": 2,\n        \"status\": 1,\n        \"statusText\": \"待制作\",\n        \"contactName\": \"张三\",\n        \"contactPhone\": \"13800000000\",\n        \"address\": \"阳光小区 3-2-301\",\n        \"remark\": \"少辣\",\n        \"createTime\": \"2026-03-12 12:00:00\",\n        \"updateTime\": \"2026-03-12 12:01:00\"\n      }\n    ],\n    \"total\": 1,\n    \"pageNum\": 1,\n    \"pageSize\": 10,\n    \"pages\": 1\n  },\n  \"timestamp\": 1718000000000\n}"
            }
          ]
        },
        {
          "name": "订单详情",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/orders/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "orders", ":id"],
              "variable": [
                { "key": "id", "value": "1024", "description": "订单 ID" }
              ]
            },
            "description": "订单详情（含订单项）"
