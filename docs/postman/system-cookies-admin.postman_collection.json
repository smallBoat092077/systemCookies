              "name": "成功示例",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"code\": 200,\n  \"message\": \"操作成功\",\n  \"data\": {\n    \"token\": \"xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx\",\n    \"userId\": 1,\n    \"role\": 1\n  },\n  \"timestamp\": 1718000000000\n}"
